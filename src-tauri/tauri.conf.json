{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MoRay",
  "version": "2.1.0",
  "identifier": "com.moray.workbench",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "windows": [
      {
        "title": "MoRay — 本地AI开发者工作台",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data: blob:; connect-src 'self' http://localhost:11434 http://127.0.0.1:11434 http://localhost:* https:; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https:; font-src https: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://your-update-server.example.com/moray/{{target}}/{{current_version}}"],
      "pubkey": "REPLACE_WITH_YOUR_MINISIGN_PUBLIC_KEY"
    }
  }
}
