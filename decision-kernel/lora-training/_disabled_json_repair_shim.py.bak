import json
import re

def repair_json(raw_str: str) -> dict | None:
    """轻量JSON修复：补全末尾缺失的逗号、括号、引号，解决小模型长JSON末尾漏标点问题"""
    s = raw_str.strip()
    # 去掉首尾可能的markdown标记
    if s.startswith("```json"):
        s = s[7:]
    if s.startswith("```"):
        s = s[3:]
    if s.endswith("```"):
        s = s[:-3]
    s = s.strip()

    # 先尝试直接解析
    try:
        return json.loads(s)
    except:
        pass

    # 从后往前补全括号
    open_braces = s.count("{") - s.count("}")
    open_brackets = s.count("[") - s.count("]")

    # 去掉末尾可能不完整的键值对
    s = re.sub(r',?\s*"[^"]*$', '', s)
    if s.endswith(","):
        s = s[:-1]

    # 补全括号
    s += "}" * max(0, open_braces)
    s += "]" * max(0, open_brackets)

    try:
        return json.loads(s)
    except:
        return None

# 测试
if __name__ == "__main__":
    test_bad = '{"decision_id": "dec-123", "quality": {"risk_level": "high", "confidence": 0.7'
    result = repair_json(test_bad)
    print("修复测试：", result)
