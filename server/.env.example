# ============================================================
# MoRay 本地后端环境变量模板
#
# 用法：复制本文件为 server/.env 后按需填写。
#   copy server\.env.example server\.env      （Windows cmd）
#   cp server/.env.example server/.env        （macOS / Linux）
#
# 注意：server/.env 里通常含 API Key，已被 .gitignore 排除，
#       不要提交到任何仓库、也不要打进分发包。
# 所有变量都可以不填：留空时后端使用内置默认值（见各项说明）。
# ============================================================

# ------------------------------------------------------------------
# 一、云端 LLM（可选）。不填也能用：前端可直连本地 Ollama，或直连任一
#     OpenAI 兼容服务商（Key 存浏览器本地）。
#     填了的话，前端「设置 → OpenAI 兼容 API → 经本地后端代理」会把请求
#     转到这里，Key 只留在本机 server/.env，不进入浏览器。
# ------------------------------------------------------------------

# 服务商接口地址（OpenAI 兼容协议），例如：
#   https://api.deepseek.com/v1
#   https://api.openai.com/v1
#   https://open.bigmodel.cn/api/paas/v4
MORAY_LLM_BASE_URL=

# 服务商 API Key（只保存在本机，不进入浏览器）
MORAY_LLM_API_KEY=

# 默认模型名：前端没指定 model、或前端给的模型名上游不接受时，代理会回落到它。
# 取值建议落在下面的 MORAY_LLM_MODELS 名单里。
MORAY_LLM_MODEL=

# 上游网关真正接受的模型名白名单（英文逗号分隔）。
# 为什么需要：前端默认模型来自本机模型列表（本地 Ollama 的 qwen2.5:7b 等），
# 这些名字直接打到云端网关会被拒绝（HTTP 400）；代理对不在名单里的名字做兜底
# 改写 → MORAY_LLM_MODEL，保证主对话始终可用。
# 不填 = 使用内置默认：deepseek-flash,deepseek-v4-pro,deepseek-chat,deepseek-reasoner
# 换服务商时只改这一项，不必改代码。
MORAY_LLM_MODELS=

# 单个 session 的 LLM 调用次数上限（内存计数，重启清零；超限返回 429）。
# 不填 = 30。
MAX_LLM_CALLS_PER_SESSION=30


# ------------------------------------------------------------------
# 二、服务本身（一般不用改）
# ------------------------------------------------------------------

# 后端监听端口（仅本机 127.0.0.1，不对外提供访问）。不填 = 8000。
MORAY_PORT=8000

# SQLite 库文件路径。不填 = server/data/moray.sqlite3。
# 把库放到别处（如临时目录）时填此项，自动化测试也用它做隔离。
#MORAY_DB=

# 本机 Agent 的受控工作区根目录（Agent 只能在这个目录下读写）。
# 不填 = 若本机已存在 D:\MoRayWorkspace 则沿用它（老用户的数据不搬家），
#        否则用 ~/MoRayWorkspace（跨平台安全位置）。
#MORAY_WORKSPACE=

# 本地研究服务（深度研究模块）地址。不填 = http://127.0.0.1:8010。
# 没有部署该服务时保持默认即可：相关工具会返回"服务未启动"的可读提示。
MORAY_ARGUS_BASE_URL=http://127.0.0.1:8010


# ------------------------------------------------------------------
# 三、MCP（Model Context Protocol）兼容层（可选）
# ------------------------------------------------------------------

# 是否把本机只读工具暴露为标准 MCP Server（SSE）。不填 = 开启（1）。
MORAY_MCP_ENABLED=1

# 允许 MCP 调用的工具白名单（英文逗号分隔）。不填 = 只放行只读工具：
#   list_directory,read_file,find_files,search_text,list_processes,system_info
# 要授权写操作必须显式列出，例如：read_file,write_file,create_file
#MORAY_MCP_ALLOWED_TOOLS=


# ------------------------------------------------------------------
# 四、外部 MCP 服务（p_mcp 迭代·任务1）
# ------------------------------------------------------------------

# Iris 报错分析 MCP Server（D:\Iris\server\mcp_server.py，默认 9301）的鉴权 Key。
# 须与 Iris 进程启动时的 IRIS_MCP_API_KEY 同值；两侧都不设 = Iris 降级为 loopback-only。
#IRIS_MCP_API_KEY=

# Iris MCP SSE 地址/开关/超时覆盖。不填 = http://127.0.0.1:9301/sse、开启、30s。
#MORAY_IRIS_MCP_URL=http://127.0.0.1:9301/sse
#MORAY_IRIS_MCP_ENABLED=1
#MORAY_IRIS_MCP_TIMEOUT=30


# ------------------------------------------------------------------
# 五、任务编排（L4 / L4.5：/api/tasks/* 与 engine/task_runner.py）
# ------------------------------------------------------------------

# llm_patch 降级通道与 Iris 分析回呼的网关地址。不填 = http://127.0.0.1:8000
#（即正式后端自身；换端口部署隔离实例时改为该实例地址）。
#IRIS_GATEWAY_URL=http://127.0.0.1:8000

# Iris MCP 鉴权 Key 见上方第四节；L4.5 起正式 .env 必配——
# 9301 实测开着鉴权：无 Key/错 Key → 401，任务模板 analyze 步必挂。

# Iris MCP 超时（秒）。不填 = 30；带截图的视觉分析实测 69.7s，建议 120。
#MORAY_IRIS_MCP_TIMEOUT=120

# 对话触发任务的候选项目列表（英文分号或逗号分隔的绝对路径）。
# 项目选择卡展示这些目录；不填 = 只有受控工作区（MORAY_WORKSPACE）一项，仍可手动输入。
#MORAY_TASK_PROJECTS=D:\MoRay;D:\MoRayWorkspace
# ---- [L5.2 主动日志监控 2026-09-28] 四键（消费端 server/app/log_monitor.py）----
# 红线：默认关闭。false = 后端不自动跑监控循环；用户在对话里说"开启监控"
# （→ POST /api/monitor/enable）才启动，重启回关。改 true 才会开机自启。
MONITOR_ENABLED=false
# 扫描间隔秒数（下限 2s；对话内"开启监控"可临时传别的值）
MONITOR_INTERVAL=60
# 监控的日志目录（相对路径按 D:\MoRay 根解析；分号/逗号可列多个）
MONITOR_LOG_DIR=logs
# 告警阈值：ERROR = ERROR/FATAL/CRITICAL 都告警；FATAL = 仅 FATAL/CRITICAL
MONITOR_ALERT_LEVEL=ERROR
# ---- [L6.0 自我进化引擎 2026-09-29] 四闸（消费端 knowledge/strategy_optimizer.py +
# knowledge/pattern_miner.py；默认全开，设 0/false/off/no 任一 = 回退 L5 固定行为）----
# 阶段2+4 诊断策略优化与修复档位自适应（权重自适应/连败跳过/深度自适应/档位偏好）
#MORAY_STRATEGY_OPTIMIZE=1
#MORAY_FIX_ADAPTIVE=1
# 阶段3 错误模式自动发现（无监督聚类生成候选规则；子开关=1 时新候选自动生效，
# 默认 0 = 只生成建议、人工确认后才参与根因分类）
#MORAY_PATTERN_MINER=1
#MORAY_PATTERN_MINER_AUTO=0
# ---- [L6.5 跨任务知识迁移 2026-09-29] 四闸（消费端 knowledge/issue_base.py +
# engine/task_runner.py 钩子；默认全开，设 0/false/off/no 任一 = 回退 L6.0 行为）----
# 统一问题库入口与来源标记（关 = 经验库按 L6.0 原样工作，不写 source/applicable 等增量键）
#MORAY_UNIFIED_ISSUE=1
# 代码审查知识赋能：审查前注入历史重点检查 + 审查后收割问题反哺（关 = 审查纯 LLM）
#MORAY_REVIEW_KNOWLEDGE=1
# 修复后自动生成回归测试建议（只建议不执行；关 = 不生成）
#MORAY_FIX_SUGGEST_TEST=1
# 测试失败自动匹配历史修复方案（关 = 不关联知识库）
#MORAY_TEST_KNOWLEDGE=1
# ---- [L7.0 任务自治引擎 2026-09-29] 总闸（消费端 engine/task_planner.py +
# engine/execution_scheduler.py + server/app/planner_routes.py）----
# 红线：默认关闭。true = 对话里的大目标（"优化一下这个项目"等）走 规划→调度→动态决策→
# 整合 全链路；false = 完全回退 L6.5 模板匹配模式（三模板/统一知识库/监控不受影响）。
#MORAY_TASK_PLANNER=false
# ---- [L7.5 Laya联动 2026-09-29] 总闸与连接参数（消费端 engine/laya_connector.py +
# server/app/laya_event_handler.py）----
# 权威配置 = 根目录 config.yaml 的 laya_link 块（enabled 默认 false = 联动全链路零生效，
# 回退 L7.0 原生）。本 env 同名键优先级更高，供隔离实例/临时翻转覆盖：
#MORAY_LAYA_LINK=0            # 联动总闸（1/on 开）
#MORAY_LAYA_HOST=127.0.0.1    # Laya 高速决策引擎地址
#MORAY_LAYA_PORT=8001         # Laya HTTP 端口
#MORAY_LAYA_TIMEOUT_MS=200    # 下行调度超时（超时静默走原生）
#MORAY_LAYA_FUSE_THRESHOLD=5  # 分级熔断：连续失败 N 次临时熔断（评审 二.2）
#MORAY_LAYA_FUSE_DURATION_S=30   # 首次熔断时长；到期自动试探，试探失败时长翻倍延长
#MORAY_LAYA_FUSE_MAX_S=600    # 熔断延长上限（秒）
#MORAY_LAYA_CONFIDENCE=0.7    # 置信度门槛：低于此值的 Laya 决策不采纳，降级原生（评审 一.1）
#MORAY_LAYA_AUTO_FIX=1        # task_exception 事件自动接入 run-error-fix
#MORAY_LAYA_EVENT_SPOOL=      # MoRay 侧事件处理失败落盘暂存（默认 work/laya/events_spool.jsonl）
# ---- [L7.5 Laya联动·Laya 侧 env（D:\python3.12 服务进程）----
#LAYA_MORAY_CALLBACK_URL=http://127.0.0.1:8000/api/laya/events  # 事件上报目标
#LAYA_RESULT_CACHE_MAX=1000   # 结果缓存 LRU 容量（评审 二.4）
#LAYA_RESULT_CACHE_TTL=600    # 结果缓存 TTL 秒（过期懒清扫 + 每256决策全量清扫）

# ------------------------------------------------------------------
# 六、Synapse 神经总线 / 反思 三闸（2026-10-07 v3-lite 补录）
# ------------------------------------------------------------------

# 消费端：server/app/synapse_bus.py + server/app/reflection.py（含下方 TIMEOUT）。
# 三闸翻转需重启 8000；代码内置默认均为关（0/120/0），此处按本机现行配置显式开启。
# 反思链：ZCode 任务成功 / Argus 研究完成（事件经 synapse_rules 规则表分发，
# 规则增删禁用直接改 server/data/synapse.sqlite3 的 synapse_rules 表，即时生效）。

# 反思总闸：1 = reflection.run 可跑（手动端点 + 总线 handler 都查它）
MORAY_REFLECTION=1

# 反思 LLM 单次调用超时（秒）。代码默认 120；本地长上下文实测建议 600。
MORAY_REFLECTION_TIMEOUT=600

# 神经总线总闸：1 = 事件落库 + consumer 消费（关 = send() 完全 no-op、规则表不生效）
MORAY_SYNAPSE=1

# ------------------------------------------------------------------
# 七、外部触达 v1：OneBot（QQ）同机对接（2026-11-01）
# ------------------------------------------------------------------
# 消费端：server/app/bot_routes.py（入站 webhook + 后台 worker）
#         server/app/bot_client.py（出站回推，只允许回环地址）。
# 翻转需重启 8000。BOT_ENABLED 关时 webhook 一律 503、worker 不起。
# 注意：MORAY_PORT 仍是唯一端口来源，这里不新增监听端口。

# 总闸：true = 启用 /api/bot/webhook 与 bot_worker
MORAY_BOT_ENABLED=false

# 入站鉴权：必须与 OneBot 侧配置的 access-token 完全一致（Authorization: Bearer <token>）。
# 留空 = 拒绝一切入站（fail-close）。不要把真实 token 提交进仓库。
MORAY_BOT_TOKEN=

# OneBot 实现（NapCat / Lagrange）的 HTTP API 根地址。只允许回环：
# 127.0.0.1 / localhost / ::1；填公网或局域网地址会在启动期被拒绝。
MORAY_BOT_API_BASE=http://127.0.0.1:3000

# OneBot HTTP API 出站鉴权（可选，与入站 token 是两个独立凭据；OneBot 未开 token 可留空）
MORAY_BOT_API_TOKEN=
