# ============================================================
# MoRay 本地后端云端 LLM 配置模板（复制为 server/.env 后填写）
# 注意：server/.env 包含 API Key，已被 .gitignore 排除，
#       绝不会被打进任何 zip/备份/部署包。
# ============================================================

# OpenAI 兼容的云端 LLM 接口地址（DeepSeek 等兼容协议）。
# 例：https://api.deepseek.com/v1
# 也可以指向本机 Ollama 的 OpenAI 兼容口 http://127.0.0.1:11434/v1 做本地代理测试
MORAY_LLM_BASE_URL=

# 云端 API Key（只保存在本机 server/.env，不会进入浏览器/前端）
MORAY_LLM_API_KEY=

# 默认模型名（前端未指定 model 时使用）
# 例：deepseek-chat / qwen3.5:9b
MORAY_LLM_MODEL=
